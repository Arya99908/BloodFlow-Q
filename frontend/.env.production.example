# Public API URL embedded in the browser bundle. This is not a secret.
# Replace the example host with the actual HTTPS API address before building.
VITE_API_BASE_URL=https://api.example.org

# Set only after applying and verifying supabase/migrations/202610130001_donor_emergency_network.sql.
# These are browser-visible project settings, not passwords. Never use a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
